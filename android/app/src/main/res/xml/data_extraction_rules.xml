<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 12 and above (FR-26). Same exclusion as
  backup_rules.xml, applied to cloud backup and to device-to-device transfer:
  turning the setting off means the tasks are not copied anywhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/private/" />
        <exclude domain="sharedpref" path="capture_inbox.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/private/" />
        <exclude domain="sharedpref" path="capture_inbox.xml" />
    </device-transfer>
</data-extraction-rules>
